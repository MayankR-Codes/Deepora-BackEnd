# Server Network Configuration (Local Development)
AUTH_HOST=127.0.0.1
AUTH_PORT=4175
DEEPORA_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,https://your-frontend.vercel.app

# Production / Vercel Environment Variables:
# NODE_ENV=production
# AUTH_SECRET=your_random_secure_hex_or_string
# COOKIE_SAMESITE=None

# Gmail Invoice Delivery Settings
ORDER_EMAIL_FROM=your_email@gmail.com
ORDER_EMAIL_TO=store_owner@gmail.com

# SMTP Settings (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_APP_PASSWORD=your_16_char_gmail_app_password

# MongoDB Connection String (Atlas Cluster or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/deepora?retryWrites=true&w=majority
MONGODB_DB_NAME=deepora
